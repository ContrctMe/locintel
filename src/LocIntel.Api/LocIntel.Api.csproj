<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The production artifact (docs/production.md): `dotnet publish -p:PublishProfile=DefaultContainer`
         builds the OCI image with no Dockerfile. Non-root by default (the base image's `app` user),
         one port, and CI smokes all three ROLEs from it before it can be called green. -->
    <ContainerRepository>locintel</ContainerRepository>
    <ContainerUser>app</ContainerUser>
    <ContainerPort>8080</ContainerPort>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

