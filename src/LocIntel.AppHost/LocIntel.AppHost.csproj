<Project Sdk="Aspire.AppHost.Sdk/13.5.3">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>2fd4f792-10e8-4d7f-ae8a-88e1ec9f5b4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.NodeJs" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocIntel.Api\LocIntel.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the one Postgres image reference (ADR 50), shared as source so the
         host does not take a dependency on the platform assembly -->
    <Compile Include="..\LocIntel.Platform\Data\PostgresImage.cs" Link="PostgresImage.cs" />
  </ItemGroup>
</Project>
