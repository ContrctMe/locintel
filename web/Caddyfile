{
    admin off
    auto_https off
}

:8080 {
    @api path /api/* /auth/* /me /objects/* /openapi/* /contact-links/* /contact/* /billing/* /healthz /livez
    handle @api {
        reverse_proxy api:8080
    }
    @public host *.localhost
    handle @public {
        reverse_proxy public:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
