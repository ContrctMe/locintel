{
  "name": "locintel-web",
  "private": true,
  "scripts": {
    "codegen:api": "pnpm --filter @locintel/codegen generate",
    "codegen:keys": "dotnet run --project ../tools/LocIntel.Tools.CodegenKeys",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev:console": "pnpm --filter @locintel/console dev",
    "dev:public": "pnpm --filter @locintel/public dev",
    "lint": "oxlint apps packages/api/src",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  }
}
